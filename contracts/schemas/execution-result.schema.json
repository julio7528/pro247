{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arqcalc.local/contracts/execution-result.schema.json",
  "title": "Orchestrator execution result",
  "type": "object",
  "required": ["schema_version", "run_id", "workflow_id", "stage_id", "task_id", "contract_refs", "status", "dry_run", "exit_code", "stdout", "stderr", "error", "outputs", "validation"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "minLength": 1},
    "task_id": {"type": ["string", "null"], "pattern": "^TASK-[0-9]{3,}$"},
    "contract_refs": {"type": "array", "items": {"$ref": "#/$defs/contractRef"}},
    "status": {"enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED"]},
    "dry_run": {"type": "boolean"},
    "exit_code": {"type": ["integer", "null"]},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "error": {"type": ["string", "null"]},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["path", "content_hash", "schema_valid"], "properties": {"path": {"type": "string"}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "schema_valid": {"type": "boolean"}, "functional_status": {"enum": ["NOT_TESTED", "PASS", "FAIL"]}}, "additionalProperties": false}},
    "validation": {"type": "object", "required": ["schema_valid", "functional_tests_performed", "messages"], "properties": {"schema_valid": {"type": "boolean"}, "functional_tests_performed": {"type": "boolean"}, "messages": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "$defs": {
    "contractRef": {"type": "object", "required": ["contract_id", "version", "content_hash"], "properties": {"contract_id": {"type": "string", "pattern": "^CONTRACT-[0-9]{3,}$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
