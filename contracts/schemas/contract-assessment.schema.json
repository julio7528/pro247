{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arqcalc.local/contracts/contract-assessment.schema.json",
  "title": "Planning contract assessment",
  "type": "object",
  "required": ["schema_version", "workflow_id", "spec_reference", "spec_hash", "assessment", "justification", "assessed_by", "tasks", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "workflow_id": {"type": "string"},
    "spec_reference": {"type": "string", "pattern": "^SPEC-[0-9]{3,}@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "spec_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assessment": {"enum": ["NO_PRODUCT_CONTRACTS_REQUIRED", "PRODUCT_CONTRACTS_REQUIRED"]},
    "justification": {"type": "string", "minLength": 10},
    "assessed_by": {"const": "tech_lead"},
    "tasks": {"type": "array", "items": {"type": "object", "required": ["task_id", "path", "task_hash", "requirement_ids", "contract_required"], "properties": {"task_id": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"}, "path": {"type": "string"}, "task_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^(RF|RNF|CA)-[0-9]{3,}$"}}, "contract_required": {"type": "boolean"}, "justification": {"type": "string"}}, "additionalProperties": false}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
